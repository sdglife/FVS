# NF Vibe Check — environment variables
# Copy to .env.local and fill in. Nothing here is committed with real values.

# --- Supabase (required) ---
# Project URL and keys from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — server-only, never exposed to the browser. All DB
# access in this app goes through server code using this key (see
# supabase/schema.sql for why RLS is intentionally not used here).
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Base URL used to build shareable session links, e.g. https://vibecheck.nvrfound.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin auth ---
# Single-creator v1 (PRD §10 decision #4): one admin, checked against these
# two values by src/lib/auth.ts. No Supabase Auth / email delivery needed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random long string used to sign the admin session cookie, e.g.:
#   openssl rand -hex 32
AUTH_SECRET=

# --- AI summary generation (PRD §7) ---
ANTHROPIC_API_KEY=

# --- Automated image sources (PRD §5.1) ---
# Are.na: personal access token, https://dev.are.na/oauth/applications
ARENA_ACCESS_TOKEN=

# Unsplash: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# AI-generated image source (lib/sources/ai-generate.ts) — pluggable.
# Set whichever provider you wire up; the connector throws a clear
# "not configured" error until one is set.
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
